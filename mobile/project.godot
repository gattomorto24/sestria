config_version=5

[application]
config/name="Sestria"
run/main_scene="res://scenes/boot.tscn"
run/main_scene.android_smoke="res://tests/android_checks.tscn"
run/main_scene.android_lan_smoke="res://tests/android_network.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/app_icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.027,0.067,0.078,1)
boot_splash/image="res://assets/ui/mobile_splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/handheld/extend_to_title=true
window/vsync/vsync_mode=1

[input_devices]
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
anti_aliasing/quality/msaa_3d=0
textures/default_filters/anisotropic_filtering_level=1

[editor_plugins]
enabled=PackedStringArray("res://addons/sestria_platform/plugin.cfg")
